{
  "name": "ibex",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "tsx scripts/benchmark.ts",
    "build:test": "node --import tsx scripts/build_browser_tests.ts",
    "data:build": "node --import tsx --max-old-space-size=12000 scripts/build_cells.ts",
    "data:publish": "node --import tsx scripts/publish.ts",
    "data:basemap": "node --import tsx scripts/basemap.ts",
    "data:cycle-routes": "node --import tsx --max-old-space-size=8000 scripts/cycle_routes.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@protomaps/basemaps": "^5.7.2",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "idb": "^8.0.0",
    "lucide-react": "^1.44.0",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^5.0.0",
    "pmtiles": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "sharp": "^0.33.5",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.0.0"
  }
}
