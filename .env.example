# Copy to .env (npm run setup does it). Only VITE_* values reach the browser bundle.

# --- App -------------------------------------------------------------------------------
# MapTiler browser key for the basemap, terrain and place search (https://cloud.maptiler.com).
# It ends up in the bundle: restrict it to your origins in the MapTiler dashboard.
VITE_MAPTILER_API_KEY=
# Root of the published routing data; the app reads <root>/catalog.json.
# Empty: the app's own data/ path, which `npm run dev` serves from .cache/cells.
VITE_DATA_URL=https://ibex.sos-ch-gva-2.exo.io/data
# Optional PMTiles archive for the "your rides" reference overlay; empty hides the toggle.
VITE_HEATMAP_URL=
# Path the app is served under. GitHub Pages serves a project repo at /<repo>/.
BASE_PATH=/ibex/

# --- Data publication (scripts/publish.ts, never the browser) -------------------------
S3_ENDPOINT=https://sos-ch-gva-2.exo.io
S3_KEY=
S3_SECRET=
S3_BUCKET=ibex
# Optional key prefix inside the bucket; the tree then lives at <prefix>/catalog.json.
S3_PREFIX=
# Public base URL of the bucket, printed as VITE_DATA_URL after a publish.
S3_PUBLIC_URL=https://ibex.sos-ch-gva-2.exo.io
# App origin used by `data:publish --verify` for the CORS check.
APP_ORIGIN=https://fxi.io

#TYPSAFE API
TYPESAFE_API_KEY=
